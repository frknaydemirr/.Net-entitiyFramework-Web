@model KurumsalWebProjesii.Models.Model.Hakkimizda

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<script type="text/javascript">
    CKEDITOR.replace('Acıklama')
</script>




@*hakkımızda kısmının HTML tag sayfası*@

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <h4>Hakkımızda</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Hakkimizdaıd)


    <div class="form-group">
        <label for="Aciklama" class="control-label col-lg-2">Açıklama <span class="required">*</span></label>
        <div class="col-lg-10">
            <textarea id="Aciklama" name="Aciklama" class="tinymce-editor" required>
            @Model.Aciklama
        </textarea>
            @Html.ValidationMessageFor(model => model.Aciklama, "", new { @class = "text-danger" })
        </div>
    </div>


    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Güncelle" class="btn btn-default" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Geri Dön", "Index")
</div>
