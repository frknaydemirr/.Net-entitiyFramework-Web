
@model IEnumerable<KurumsalWebProjesii.Models.Model.Kategori>
    @*kimlik tablasundan gelen verileri görüntülemek*@


@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
 

@*itemlar talep ettiğimiz modelden gelecek*@



<section class="section dashboard">
    <div class="row">
        <div class="col-lg-8">
            <div class="row">

                <div class="col-xxl-4 col-xl-12">

                    <div class="card info-card customers-card">


                        <div class="card-body">
                            <h5 class="card-title">@ViewBag.BlogSay</h5>

                            <div class="d-flex align-items-center">
                                <div class="ps-3">
                                    @*<h6>@ViewBag.BlogSay</h6>*@
                                    <span class="text-danger small pt-1 fw-bold">12%</span> <span class="text-muted small pt-2 ps-1">Blog Yazısı</span>

                                </div>
                            </div>

                        </div>

                    </div>

                </div>
                <div class="col-xxl-4 col-xl-12">

                    <div class="card info-card customers-card">


                        <div class="card-body">
                            <h5 class="card-title">@ViewBag.KategoriSay</h5>

                            <div class="d-flex align-items-center">
                                <div class="ps-3">
                                    @*<h6>@ViewBag.BlogSay</h6>*@
                                    <span class="text-danger small pt-1 fw-bold">@ViewBag.BlogSay</span><span class="text-muted small pt-2 ps-1">Blog Yazısı @ViewBag.BlogSay</span>

                                </div>
                            </div>

                        </div>

                    </div>

                </div>




            </div>
        </div>


    </div>
</section>
