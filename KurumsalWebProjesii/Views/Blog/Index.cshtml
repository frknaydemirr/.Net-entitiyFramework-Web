
@model IEnumerable<KurumsalWebProjesii.Models.Model.Blog>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/DataTables/jquery.dataTables.js"></script>
<link href="~/Content/DataTables/css/jquery.dataTables.css" rel="stylesheet" />
<script>
    $(document).ready(function () {
        $('#myTable').DataTable(

            {
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/9dcbecd42ad/i18n/Turkish.json"
                }
            }
        );
    });
</script>
@*bu script kodlar thead ve tbody olmadan çalışmıyor!*@


<h2>Blog Kayıtları </h2>

<a class="btn btn-danger" href="/YeniBlog">Yeni Blog Ekle</a>

<table class="table table-striped" id="myTable">
    <thead>
        <tr>
            <th>#</th>
            <th>Başlık</th>
            <th>Kategori</th>
            <th>Resim URL</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Baslık</td>
                <td>@item.Kategoriıd</td>
                <td><img src="@item.ResimURL" width="100" height="100" /></td>
                <td><a href="/Blog/Edit/@item.Id">Güncelle</a> | <a href="/Blog/Delete/@item.Id">Sil</a></td>
            </tr>
        }


    </tbody>
</table>
