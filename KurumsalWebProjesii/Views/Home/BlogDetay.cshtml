@model KurumsalWebProjesii.Models.Model.Blog
@{
    ViewBag.Title = "BlogDetay";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<h2>BlogDetay</h2>



<main class="main">

    <!-- Page Title -->
    <div class="page-title dark-background">
        <div class="container position-relative">
            <h1>Blog</h1>
            <p>Esse dolorum voluptatum ullam est sint nemo et est ipsa porro placeat quibusdam quia assumenda numquam molestias.</p>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="index.html">Home</a></li>
                    <li class="current">Blog Detay</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->
    <!-- Blog Posts Section -->
    <section id="blog-posts" class="blog-posts section">
        <div class="container">
            <div class="row gy-4">

                <div class="col-lg-8 col-md-8">
                    <article>
                        <div class="post-img">
                            <img src="@Model.ResimURL" alt="@Model.Baslık" class="img-fluid w-100">
                        </div>

                        <p class="post-category">
                            <a>@Model.Baslık </a>
                        </p>
                        <div class="post-meta">
                            <p class="post-author">@Model.Kategori.KategoriAd</p>
                        </div>

                        <h2 class="title">
                            @*@Html.Raw(@Model.Icerik)*@
                            @*aaaaaaaa
                            *@<!--Model.Icerik-->

                        </h2>

                        <div class="d-flex align-items-center">
                            <img src="assets/img/blog/blog-author.jpg" alt="" class="img-fluid post-author-img flex-shrink-0">
                        </div>
                    </article>
                 




                    <section id="comment-form" class="comment-form section">
                        <div class="container ">

                            <form action="/Home/YorumYap/@Model.Id">

                                <h4>Yorum Yap</h4>
                                <div class="row ">
                                    <div class=" form-group">
                                        <input type="text" id="adsoyad" class="form-control" placeholder="Adınız Soyadınız" required>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col form-group">
                                        <input type="email" class="form-control" id="eposta" placeholder="Mail Adresiniz" required>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col form-group">
                                        <textarea typeof="text" class="form-control" id="icerik"></textarea>
                                    </div>
                                </div>
                                <input type="hidden" name="Blogıd" value=" @Model.Id" />

                                <div class="text-center">
                                    <button type="submit" id="gonder" class="btn btn-primary" value="Yorum Yap">Yorum Yap</button>
                                </div>

                            </form>

                        </div>
                    </section><!-- /Comment Form Section -->


                </div>
                <div class="col-lg-4 col-lg-md-4">
                    <div class="search-widget widget-item">

                        <h3 class="widget-title">Search</h3>
                        <form action="">
                            <input type="text">
                            <button type="submit" title="Search"><i class="bi bi-search"></i></button>
                        </form>

                    </div><!--/Search Widget -->
                    <!-- Categories Widget -->
                    <div class="categories-widget widget-item">

                        <h3 class="widget-title">Categories</h3>
                        <ul class="mt-3">
                            <li><a href="#">General <span>(25)</span></a></li>
                            <li><a href="#">Lifestyle <span>(12)</span></a></li>
                            <li><a href="#">Travel <span>(5)</span></a></li>
                            <li><a href="#">Design <span>(22)</span></a></li>
                            <li><a href="#">Creative <span>(8)</span></a></li>
                            <li><a href="#">Educaion <span>(14)</span></a></li>
                        </ul>

                    </div><!--/Categories Widget -->
                    <!-- Recent Posts Widget -->
                    <div class="recent-posts-widget widget-item">

                        <h3 class="widget-title">Recent Posts</h3>

                        <div class="post-item">
                            <img src="@Model.ResimURL" alt="" class="flex-shrink-0">
                            <div>
                                <h4><a href="blog-details.html">Nihil blanditiis at in nihil autem</a></h4>
                                <time datetime="2020-01-01">Jan 1, 2020</time>
                            </div>
                        </div><!-- End recent post item-->

                        <div class="post-item">
                            <img  src="@Model.ResimURL" alt="" class="flex-shrink-0">
                            <div>
                                <h4><a href="blog-details.html">Quidem autem et impedit</a></h4>
                                <time datetime="2020-01-01">Jan 1, 2020</time>
                            </div>
                        </div><!-- End recent post item-->

                        <div class="post-item">
                            <img  src="@Model.ResimURL" alt="" class="flex-shrink-0">
                            <div>
                                <h4><a href="blog-details.html">Id quia et et ut maxime similique occaecati ut</a></h4>
                                <time datetime="2020-01-01">Jan 1, 2020</time>
                            </div>
                        </div><!-- End recent post item-->

                        <div class="post-item">
                            <img  src="@Model.ResimURL" alt="" class="flex-shrink-0">
                            <div>
                                <h4><a href="blog-details.html">Laborum corporis quo dara net para</a></h4>
                                <time datetime="2020-01-01">Jan 1, 2020</time>
                            </div>
                        </div><!-- End recent post item-->

                        <div class="post-item">
                            <img  src="@Model.ResimURL" alt="" class="flex-shrink-0">
                            <div>
                                <h4><a href="blog-details.html">Et dolores corrupti quae illo quod dolor</a></h4>
                                <time datetime="2020-01-01">Jan 1, 2020</time>
                            </div>
                        </div><!-- End recent post item-->

                    </div><!--/Recent Posts Widget -->

                    <div class="tags-widget widget-item">

                        <h3 class="widget-title">Tags</h3>
                        <ul>
                            <li><a href="#">App</a></li>
                            <li><a href="#">IT</a></li>
                            <li><a href="#">Business</a></li>
                            <li><a href="#">Mac</a></li>
                            <li><a href="#">Design</a></li>
                            <li><a href="#">Office</a></li>
                            <li><a href="#">Creative</a></li>
                            <li><a href="#">Studio</a></li>
                            <li><a href="#">Smart</a></li>
                            <li><a href="#">Tips</a></li>
                            <li><a href="#">Marketing</a></li>
                        </ul>

                    </div><!--/Tags Widget -->

                </div>

                </div>

        </div>
        </div>
    </section>





</main>
