@using PagedList ;
@using PagedList.Mvc;
@model IPagedList<KurumsalWebProjesii.Models.Model.Blog>
@using KurumsalWeb.Helper;
@using KurumsalWeb.Helper;
@{
    ViewBag.Title = "Blog";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}


<main class="main">

    <!-- Page Title -->
    <div class="page-title dark-background">
        <div class="container position-relative">
            <h1>Blog</h1>
            <p>Esse dolorum voluptatum ullam est sint nemo et est ipsa porro placeat quibusdam quia assumenda numquam molestias.</p>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="index.html">Home</a></li>
                    <li class="current">Blog</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->
    <!-- Blog Posts Section -->
    <section id="blog-posts" class="blog-posts section">
        <div class="container">
            <div class="row gy-4">

                <!-- Sol taraf: Blog Gönderileri -->
                <div class="col-lg-8 col-md-8">
                    <div class="row">
                        @foreach (var item in Model)
                        {
                            <div class="col-lg-6 col-md-6">
                                <article>
                                    <div class="post-img">
                                        <img src="@item.ResimURL" alt="@item.Baslık" class="img-fluid">
                                    </div>

                                    <p class="post-category">
                                        <a href="/Blog/@SeoHelper.ToSeoUrl(item.Baslık).ToLower()-@item.Id">@item.Baslık</a>
                                    </p>

                                    <h2 class="title">
                                        @Html.Raw(item.Icerik != null && item.Icerik.Length > 10 ? item.Icerik.Substring(0, 10) : item.Icerik)
                                    </h2>

                                    <div class="d-flex align-items-center">
                                        <img src="assets/img/blog/blog-author.jpg" alt="" class="img-fluid post-author-img flex-shrink-0">
                                        <div class="post-meta">
                                            <p class="post-author">@item.Kategori.KategoriAd</p>
                                            <a href="/Home/BlogDetay/@item.Id">Devam Et</a>
                                        </div>
                                    </div>
                                </article>
                            </div> <!-- End col-lg-6 -->
                        }
                    </div> <!-- End row -->
                </div> <!-- End col-lg-8 -->
                <!-- Sağ taraf: Sidebar -->
                <div class="col-lg-4 col-md-4">
                    <!-- Search Widget -->
                    <div class="search-widget widget-item">
                        <h3 class="widget-title">Search</h3>
                        <form action="">
                            <input type="text">
                            <button type="submit" title="Search"><i class="bi bi-search"></i></button>
                        </form>
                    </div>

                    <!-- Categories Widget -->
                    <div class="categories-widget widget-item">
                        <h3 class="widget-title">Categories</h3>
                        <ul class="mt-3">
                            @foreach (var item in Model)
                            {
                                <li>
                                    <a href="#">@item.Kategori.KategoriAd <span>(@item.Kategori.Kategoriıd)</span></a>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Recent Posts Widget -->
                    <div class="recent-posts-widget widget-item">
                        <h3 class="widget-title">Recent Posts</h3>
                        @foreach (var item in Model)
                        {
                            <div class="post-item d-flex">
                                <img src="@item.ResimURL" alt="" class="flex-shrink-0">
                                <div>
                                    <h4><a href="/Home/BlogDetay/@item.Id">@item.Baslık</a></h4>
                                    <time datetime="2020-01-01">Jan 1, 2020</time>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Tags Widget -->
                    <div class="tags-widget widget-item">
                        <h3 class="widget-title">Tags</h3>
                        <ul>
                            <li><a href="#">App</a></li>
                            <li><a href="#">IT</a></li>
                            <li><a href="#">Business</a></li>
                            <li><a href="#">Mac</a></li>
                            <li><a href="#">Design</a></li>
                            <li><a href="#">Office</a></li>
                            <li><a href="#">Creative</a></li>
                            <li><a href="#">Studio</a></li>
                            <li><a href="#">Smart</a></li>
                            <li><a href="#">Tips</a></li>
                            <li><a href="#">Marketing</a></li>
                        </ul>
                    </div>

                </div> <!-- End col-lg-4 -->

            </div> <!-- End row -->
        </div> <!-- End container -->
    </section>

    <!-- /Blog Posts Section -->
    <!-- Blog Pagination Section -->


    <section id="blog-pagination" class="blog-pagination section">
        @Html.PagedListPager(Model, page => Url.Action("Blog", new { Sayfa = page }))
        @*<div class="container">
            <div class="d-flex justify-content-center">
                <ul>
                    <li><a href="#"><i class="bi bi-chevron-left"></i></a></li>
                    <li><a href="#">1</a></li>
                    <li><a href="#" class="active">2</a></li>
                    <li><a href="#">3</a></li>
                    <li><a href="#">4</a></li>
                    <li>...</li>
                    <li><a href="#">10</a></li>
                    <li><a href="#"><i class="bi bi-chevron-right"></i></a></li>
                </ul>
            </div>
        </div>*@

    </section><!-- /Blog Pagination Section -->

</main>
