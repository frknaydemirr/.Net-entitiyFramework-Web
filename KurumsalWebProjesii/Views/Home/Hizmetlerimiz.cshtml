@model IEnumerable<KurumsalWebProjesii.Models.Model.Hizmet>

@{
    ViewBag.Title = "Hizmetlerimiz";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<main class="main">

    <!-- Page Title -->
    <div class="page-title dark-background mb-5">
        <div class="container position-relative">
            <h1>Hizmetlerimiz</h1>
            <p>Esse dolorum voluptatum ullam est sint nemo et est ipsa porro placeat quibusdam quia assumenda numquam molestias.</p>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="index.html">Home</a></li>
                    <li class="current">Portfolio</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->
    <!-- Portfolio Section -->
    <section id="portfolio" class="portfolio section">


        <div class="container">

            <div class="isotope-layout" data-default-filter="*" data-layout="masonry" data-sort="original-order">
                <div class="row gy-4 isotope-container" data-aos="fade-up" data-aos-delay="200">

                    @foreach (var item in Model)
                    {
                        <div class="col-lg-4 col-md-6 portfolio-item isotope-item filter-app">
                            <div class="portfolio-content h-100">
                                <img src="@item.ResimURL" class="img-fluid" alt="@item.Acıklama">
                                <div class="portfolio-info">
                                    <h4>@item.Baslık</h4>
                                    <p>@Html.Raw(item.Acıklama)</p>

                                    <a href="@item.ResimURL" title="@item.Acıklama" data-gallery="portfolio-gallery-app" class="glightbox preview-link"><i class="bi bi-zoom-in"></i></a>
                                    <a href="portfolio-details.html" title="@item.Acıklama" class="details-link"><i class="bi bi-link-45deg"></i></a>
                                </div>
                            </div>
                        </div>
                    }


                </div>

            </div>

        </div>

    </section><!-- /Portfolio Section -->

</main>