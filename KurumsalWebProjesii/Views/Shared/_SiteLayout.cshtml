                <!-- <img src="assets/img/logo.png" alt=""> -->
                <h1 class="sitename">KURUMSALWEB</h1>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul>
                    <li><a href="/Home/Index/" class="active">Ana Sayfa</a></li>
                    <li><a href="/Home/Hakkimizda/">Hakkımızda</a></li>
                    <li><a href="/Home/Hizmetlerimiz/">Hizmetlerimiz</a></li>
                    <li><a href="/Home/Blog/">Blog</a></li>
                    <li><a href="/Home/İletisim/">İletişim</a></li>
                    @*<li class="dropdown">
                        <a href="#"><span>Dropdown</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                        <ul>
                           <li><a href="#">Dropdown 1</a></li>
                            <li class="dropdown">
                                <a href="#"><span>Hakkımızda</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                                <ul>
                                    <li><a href="#">Ana Sayfa</a></li>
                                    <li><a href="#">Deep Dropdown 2</a></li>
